{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Chrome Extension",
      "type": "chrome",
      "request": "launch",
      "url": "https://egela.ehu.eus/",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "../src/*": "${webRoot}/src/*",
        "../../src/*": "${webRoot}/src/*",
        "webpack://chrome-extension-vite/./src/*": "${webRoot}/src/*",
        "webpack:///./src/*": "${webRoot}/src/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "urlFilter": "*"
    },
    {
      "name": "Debug Brave Extension",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
      "url": "https://egela.ehu.eus/",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "../src/*": "${webRoot}/src/*",
        "../../src/*": "${webRoot}/src/*",
        "webpack://chrome-extension-vite/./src/*": "${webRoot}/src/*",
        "webpack:///./src/*": "${webRoot}/src/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "urlFilter": "*"
    }
  ]
}
