{
  "manifest_version": 3,
  "name": "Mi Extensión de Chrome",
  "version": "1.0.0",
  "description": "Una extensión de Chrome que modifica dinámicamente una página PHP utilizando React.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}