{
    "manifest_version": 3,
    "name": "Moodlia",
    "version": "1.0.0",
    "description": "A Chrome extension for eGela",
    "icons": {
        "16": "icons/icon64.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "src/background/background.ts"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "icons/icon64.png",
            "64": "icons/icon64.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "src/options/options.html",
    "content_scripts": [
        {
            "matches": ["https://egela.ehu.eus/*"],
            "js": ["src/content/content.tsx"],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/*", "assets/icons/*"],
            "matches": ["<all_urls>"]
        }
    ]
}
