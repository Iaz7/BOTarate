{
  "manifest_version": 3,
  "name": "Mi Extensión de Chrome",
  "version": "1.0.0",
  "description": "Una extensión de Chrome que modifica dinámicamente una página PHP utilizando React.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://egela.ehu.eus/*"
      ],
      "js": [
        "src/content/content.tsx"
      ],
      "run_at": "document_end"
    }
  ]
}